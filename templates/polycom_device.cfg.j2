<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Generated by asterisk-web — do not edit manually -->
<polycomConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="polycomConfig.xsd">

  <reg reg.1.address="{{ extension | e }}"
       reg.1.auth.userId="{{ extension | e }}"
       reg.1.auth.password="{{ password | e }}"
       reg.1.label="{{ display_name | e }}"
       reg.1.type="SIP"
       reg.1.server.1.address="{{ asterisk_ip | e }}"
       reg.1.server.1.port="{{ sip_port }}"
       reg.1.server.1.transport="UDPOnly"
       reg.1.server.1.expires="3600"/>

  <voIpProt voIpProt.SIP.enable="1"
            voIpProt.SIP.localSIPPort="5060"/>

  <dialplan dialplan.digitmap="[2-9]11|0T|+1[2-9]xxxxxxxxx|[2-9]xxxxxxxxx|[2-9]xxxT"
            dialplan.digitmap.timeOut="3|3|3|3|3"/>

  <call call.callsPerLineKey="1"/>

  <up up.url="http://{{ provisioning_ip | e }}:{{ http_port }}/polycom/"/>

</polycomConfig>
