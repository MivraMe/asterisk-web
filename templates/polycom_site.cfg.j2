<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Generated by asterisk-web — do not edit manually -->
<polycomConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="polycomConfig.xsd">

  <!-- Provisioning server -->
  <device device.set="1"
          device.prov.serverName="{{ provisioning_ip | e }}"
          device.prov.serverType="HTTP"
          device.prov.user="{{ prov_user | e }}"
          device.prov.password="{{ prov_password | e }}"/>

  <!-- SIP server defaults (overridden per device) -->
  <voIpProt voIpProt.SIP.enable="1"/>

  <!-- NTP / timezone -->
  <tcpIpApp tcpIpApp.sntp.address="pool.ntp.org"
            tcpIpApp.sntp.gmtOffset="0"/>

  <!-- Feature enables -->
  <feature feature.forward.enable="1"
           feature.doNotDisturb.enable="1"/>

</polycomConfig>
