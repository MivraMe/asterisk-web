; ============================================================
; GENERATED FILE — do not edit by hand.
; Rendered by app/config_generator.py from the "extensions", "trunks",
; "ring_groups", "inbound_routes" and "outbound_routes" tables, in full,
; every time. Any manual edit is lost the next time ANY extension, trunk or
; route is created/updated/deleted anywhere in the management UI — not just
; when this specific record changes.
; ============================================================

{% macro dial_action(dtype, dvalue) %}
{% if dtype == 'extension' %}
 same => n,Dial(PJSIP/{{ dvalue }},20)
 same => n,Voicemail({{ dvalue }}@default,u)
{% elif dtype == 'ring_group' %}
 same => n,Goto(ringgroup-{{ dvalue }},s,1)
{% elif dtype == 'ivr' %}
 same => n,Goto(ivr,s,1)
{% elif dtype == 'voicemail' %}
 same => n,Voicemail({{ dvalue }}@default,u)
{% else %}
 same => n,Hangup()
{% endif %}
{%- endmacro %}

[general]
static = yes
writeprotect = no
clearglobalvars = no

[globals]

; ------------------------------------------------------------------
; Internal — extension-to-extension dialing, own-mailbox access,
; follow-me/call forwarding, paging
; ------------------------------------------------------------------
[internal]
{% for ext in extensions %}
exten => {{ ext.extension }},1,NoOp(Call to {{ ext.extension }})
{% if ext.follow_me_enabled and ext.follow_me_numbers and ext.follow_me_strategy == 'simultaneous' %}
; Follow-me (simultaneous) — desk phone and all external numbers ring in a
; single Dial() together. External legs go via a Local channel back into
; this same context's outbound routing below, so trunk selection/failover
; is reused instead of hardcoding a trunk for the forwarded leg.
 same => n,Dial(PJSIP/{{ ext.extension }}{% for num in ext.follow_me_numbers %}&Local/{{ num }}@internal/n{% endfor %},{{ ext.follow_me_timeout }})
 same => n,GotoIf($["${DIALSTATUS}" = "ANSWER"]?end)
{% else %}
 same => n,Dial(PJSIP/{{ ext.extension }},{{ ext.follow_me_timeout if (ext.follow_me_enabled and ext.follow_me_numbers) else 20 }})
 same => n,GotoIf($["${DIALSTATUS}" = "ANSWER"]?end)
{% if ext.follow_me_enabled and ext.follow_me_numbers %}
; Follow-me (sequential) — external numbers rung one at a time, in order,
; each via a Local channel into this context's outbound routing below.
{% for num in ext.follow_me_numbers %}
 same => n,Dial(Local/{{ num }}@internal/n,20)
 same => n,GotoIf($["${DIALSTATUS}" = "ANSWER"]?end)
{% endfor %}
{% endif %}
{% endif %}
{% if ext.voicemail_enabled %}
 same => n,Voicemail({{ ext.extension }}@default,u)
{% else %}
 same => n,Hangup()
{% endif %}
 same => n(end),Hangup()

{% endfor %}
exten => *97,1,NoOp(Check own voicemail)
 same => n,VoiceMailMain(${CALLERID(num)}@default)
 same => n,Hangup()

exten => *98,1,NoOp(Check voicemail, prompt for mailbox)
 same => n,VoiceMailMain()
 same => n,Hangup()

; Paging/intercom — one-way multicast RTP to phones listening on the
; standard page-group address (Polycom: 224.0.1.116:5001, channel 1 =
; normal priority). Dial *80 from any phone, or trigger it from the
; dashboard's "Page all" button (AMI Originate of Local/*80@internal).
; Channels 24/25 (priority/emergency, Polycom convention) aren't wired up —
; duplicate this extension on a different multicast port if you need them.
;
; MulticastRTP's dial string is MulticastRTP/<type>/<host:port> only — a
; 3rd slash-separated field is parsed as a *control* address, not a codec
; (confirmed via `core show channeltype MulticastRTP` on Asterisk 22).
; There is no way to pick a codec from the dial string at all: the channel
; just uses whatever format the calling channel is already writing/reading
; when Dial() creates it. Left alone that's whatever codec this extension's
; PJSIP endpoint negotiated (opus/g722 by default — see endpoint-template),
; which static-multicast paging listeners like Polycom's don't expect
; (they assume ulaw, RTP payload type 0, no signaling to negotiate
; anything else). Forcing the channel to ulaw before Dial() is what
; actually gets audio to play on the phones.
exten => *80,1,NoOp(Page all)
 same => n,Answer()
 same => n,Set(CHANNEL(write_format)=ulaw)
 same => n,Set(CHANNEL(read_format)=ulaw)
 same => n,Wait(1)
 same => n,Dial(MulticastRTP/basic/224.0.1.116:5001,10)
 same => n,Hangup()

; Record a custom IVR greeting from any internal phone — see
; [ivr-record-greeting] below for the record/review/confirm flow. Reachable
; from [ivr] too (it includes internal), same as *97/*98/*80.
exten => *81,1,Goto(ivr-record-greeting,s,1)

; ------------------------------------------------------------------
; Outbound routing — patterns matched in ascending priority, first
; available trunk that answers wins; falls through to the next on failure.
; ------------------------------------------------------------------
{% for pattern, routes in outbound_by_pattern %}
exten => {{ pattern }},1,NoOp(Outbound match {{ pattern }})
{% for route in routes %}
 same => n,Set(OUTNUM=${EXTEN:{{ route.strip_digits }}})
 same => n,Dial(PJSIP/{{ route.prepend or '' }}${OUTNUM}@trunk_{{ route.trunk_name }},60)
 same => n,GotoIf($["${DIALSTATUS}" = "ANSWER"]?outdone)
{% endfor %}
 same => n,Congestion()
 same => n(outdone),Hangup()

{% endfor %}
; ------------------------------------------------------------------
; Ring groups
; ------------------------------------------------------------------
{% for rg in ring_groups %}
[ringgroup-{{ rg.name }}]
exten => s,1,NoOp(Ring group {{ rg.name }} ({{ rg.strategy }}))
{% if rg.strategy == 'hunt' %}
{% for member in rg.extensions %}
 same => n,Dial(PJSIP/{{ member }},{{ rg.ring_timeout }})
 same => n,GotoIf($["${DIALSTATUS}" = "ANSWER"]?done)
{% endfor %}
{% else %}
{% set members = rg.extensions|shuffle if rg.strategy == 'random' else rg.extensions %}
 same => n,Dial({% for member in members %}PJSIP/{{ member }}{% if not loop.last %}&{% endif %}{% endfor %},{{ rg.ring_timeout }})
 same => n,GotoIf($["${DIALSTATUS}" = "ANSWER"]?done)
{% endif %}
{{ dial_action(rg.fallback_destination_type, rg.fallback_destination_value or '') }}
 same => n(done),Hangup()

{% endfor %}
; ------------------------------------------------------------------
; IVR — single auto-attendant, reachable from any inbound route with
; destination_type=ivr. Callers who know their party's extension can dial
; it immediately (direct-dial is just "include => internal" below); press
; 1 for the directory submenu (search by name, or browse a spoken list);
; no input within the configured timeout falls back to the configured
; destination. Speaks French (CHANNEL(language)=fr, CORE-SOUNDS-FR-ULAW) —
; Asterisk transparently falls back to the English set for any prompt the
; French pack doesn't ship.
;
; Greeting prompts (vm-enter-num-to-call, vm-press, dir-welcome,
; pbx-invalid) were confirmed against a real compiled Asterisk 22 —
; present in both CORE-SOUNDS-EN-ULAW and CORE-SOUNDS-FR-ULAW, and
; vm-enter-num-to-call's usage matches Asterisk's own sample dialplan
; (configs/samples/extensions.conf.sample, the "acme-incoming" example)
; for exactly this "you may dial now" cue. Directory() plays its own
; dir-welcome intro automatically when invoked (confirmed in
; apps/app_directory.c) — it is intentionally NOT played again by
; [ivr-directory] before calling it, to avoid hearing it twice.
;
; Greeting: plays a custom-recorded message if one exists (recorded by
; dialing *81 from any internal phone — see [ivr-record-greeting] below),
; else falls back to the built-in prompts. This whole branch (both the
; STAT(e,...) existence check and the Background() playback of a real
; recorded .wav) was confirmed end-to-end against a real compiled
; Asterisk 22: a valid file at ivr-prompts/greeting.wav plays via the
; "custom" branch with no warnings, removing it falls back to "default"
; immediately (no dialplan reload needed, STAT() is evaluated live per
; call). Recording a custom greeting is also the way to make the menu
; options explicit in your own words (e.g. "for the directory, press 1")
; since no stock Asterisk sound says that — the /ivr admin page documents
; the exact key layout as a script to read when recording.
;
; Note: because "1" is also a valid prefix of some multi-digit extensions,
; Asterisk will briefly wait for more digits after a caller presses 1
; before committing to the directory submenu (standard DTMF overlap
; behavior, not a bug) — same as this ambiguity would exist in any
; auto-attendant that recycles "1" as both a menu option and a possible
; extension prefix.
; ------------------------------------------------------------------
[ivr]
exten => s,1,Answer()
 same => n,Set(CHANNEL(language)=fr)
 same => n,Wait(1)
 same => n,GotoIf($["${STAT(e,/var/spool/asterisk/ivr-prompts/greeting.wav)}" = "1"]?custom:default)
 same => n(default),Background(vm-enter-num-to-call)
 same => n,Background(vm-press)
 same => n,SayDigits(1)
 same => n,Goto(waitkey)
 same => n(custom),Background(/var/spool/asterisk/ivr-prompts/greeting)
 same => n(waitkey),WaitExten({{ ivr_settings.timeout_seconds }})

exten => 1,1,Goto(ivr-directory,s,1)

exten => i,1,NoOp(IVR: invalid entry)
 same => n,Playback(pbx-invalid)
 same => n,Goto(s,1)

exten => t,1,NoOp(IVR: timeout, falling back)
{{ dial_action(ivr_settings.fallback_destination_type, ivr_settings.fallback_destination_value or '') }}
 same => n,Hangup()

include => internal

; ------------------------------------------------------------------
; Record a custom IVR greeting from any internal phone (*81). Records
; into a working file first, plays it back, and only promotes it to the
; live greeting.wav (the file [ivr] checks) on explicit confirm — an
; aborted or re-recorded attempt never touches the greeting actually in
; use. The "mv" is a fully hardcoded literal (no channel/caller data is
; ever interpolated into it), so TrySystem() here carries none of the
; injection risk a caller-data-driven shell-out would — it's used instead
; of System() so a non-zero exit status doesn't hang up the call.
;
; Confirmed end-to-end against a real compiled Asterisk 22 (`channel
; originate` + AMI PlayDTMF driving the actual menu, no phone hardware
; needed): Record()'s syntax is `Record(filename.format,silence,
; maxduration,options)` — the format is part of the filename (dot
; separator), unlike Background()/Playback() which take a bare filename —
; confirmed via `core show application Record`. '#' correctly terminates
; the recording early (per app_record's own docs); 'q' suppresses
; Record()'s own beep since [ivr-record-greeting] plays its own before
; starting. Pressing "1" after review correctly ran the TrySystem() mv and
; promoted the file; letting WaitExten(10) time out correctly looped back
; to re-record without touching any previously-saved greeting.wav.
; ------------------------------------------------------------------
[ivr-record-greeting]
exten => s,1,Answer()
 same => n,Set(CHANNEL(language)=fr)
 same => n(record),Playback(beep)
 same => n,Record(/var/spool/asterisk/ivr-prompts/greeting-new.wav,3,300,q)
 same => n,Playback(/var/spool/asterisk/ivr-prompts/greeting-new)
 same => n,Background(vm-press)
 same => n,SayDigits(1)
 same => n,Background(vm-press)
 same => n,SayDigits(2)
 same => n,Background(vm-press)
 same => n,SayDigits(3)
 same => n,WaitExten(10)

exten => 1,1,NoOp(Save new custom IVR greeting)
 same => n,TrySystem(mv -f /var/spool/asterisk/ivr-prompts/greeting-new.wav /var/spool/asterisk/ivr-prompts/greeting.wav)
 same => n,Playback(beep)
 same => n,Hangup()

exten => 2,1,Goto(s,record)

exten => 3,1,NoOp(Cancel IVR greeting recording, discard working file)
 same => n,Hangup()

exten => i,1,Goto(s,record)
exten => t,1,Goto(s,record)

; ------------------------------------------------------------------
; IVR directory submenu — search by name (spelled, app_directory) or
; browse a spoken list of the same pool (voicemail-enabled extensions).
; ------------------------------------------------------------------
[ivr-directory]
exten => s,1,Background(vm-press)
 same => n,SayDigits(1)
 same => n,Background(vm-press)
 same => n,SayDigits(2)
 same => n,WaitExten({{ ivr_settings.timeout_seconds }})

exten => 1,1,NoOp(IVR directory: search by name)
 same => n,Directory(default,internal)
 same => n,Goto(ivr,s,1)

exten => 2,1,Goto(ivr-directory-list,s,1)

exten => i,1,NoOp(IVR directory: invalid entry)
 same => n,Playback(pbx-invalid)
 same => n,Goto(s,1)

exten => t,1,NoOp(IVR directory: timeout)
 same => n,Goto(ivr,s,1)

; ------------------------------------------------------------------
; IVR directory — browsable list. Extensions with voicemail enabled AND
; opted into the directory (listed_in_directory — see
; config_generator.py::compute_directory_list()), alphabetical by display
; name, capped at 9 so each entry gets a single selection digit. Each
; entry announces the caller's own recorded name (dial *97 -> mailbox
; options -> record your name) if they've recorded one, else
; SayDigits(extension) as a guaranteed fallback. Background() is
; DTMF-interruptible, so pressing a digit as soon as you hear the right
; entry should route immediately rather than waiting for the rest of the
; list to finish (verify with a real call).
;
; NOTE: /var/spool/asterisk matches astspooldir in
; asterisk/etc-asterisk/asterisk.conf — update here if that ever changes.
; The path below (.../voicemail/<context>/<mailbox>/greet) is confirmed
; directly from apps/app_voicemail.c's own construction of this exact
; filename: snprintf(prefile, ..., "%s%s/%s/greet", VM_SPOOL_DIR,
; vmu->context, vms->username). The .wav extension checked by STAT() is a
; reasoned choice, not the same 1:1 source confirmation as the path: it
; relies on Asterisk recording a greeting into every format listed in
; voicemail.conf's [general] "format" setting (currently wav49|wav) —
; "wav" being explicitly one of those, this should exist whenever a name
; has been recorded — but was reported not being picked up reliably in
; real usage. The STAT()/GotoIf/Background() mechanism itself is proven
; correct against a real compiled Asterisk 22 (both branches: a real
; recorded-name file plays, a missing one falls back to SayDigits — same
; test as the [ivr] custom-greeting branch above). What's still NOT
; independently confirmed is whether a real *97 -> VoiceMailMain -> record
; name session, walked with real DTMF, actually writes the file at this
; exact path — an attempt to script that end-to-end this round (AMI
; PlayDTMF driving the real menu, no phone hardware) got mailbox PIN entry
; working but couldn't reliably deliver a multi-digit DTMF sequence
; through the sandbox's channel-relay technique (each isolated digit
; delivers fine, as proven by *81's confirm menu above, but a rapid
; multi-digit run kept dropping digits — a test-harness limitation, not
; evidence of a dialplan bug). The Verbose() line below logs the exact
; path and STAT() result for every entry on every call, specifically so a
; real mismatch is visible in `asterisk -rx "core set verbose 3"` / the
; full log without having to reproduce blind — check that log during the
; next real *97 recording, or `find /var/spool/asterisk/voicemail -type f`
; to see what actually landed on disk, and fix the STAT() path below if it
; doesn't match.
; ------------------------------------------------------------------
[ivr-directory-list]
exten => s,1,NoOp(IVR directory list: {{ directory_list|length }} entries)
{% for ext in directory_list %}
 same => n,Set(RECNAMEPATH{{ loop.index }}=/var/spool/asterisk/voicemail/default/{{ ext.extension }}/greet.wav)
 same => n,Verbose(2,IVR directory list: {{ ext.extension }} -> checking ${RECNAMEPATH{{ loop.index }}} -> STAT=${STAT(e,${RECNAMEPATH{{ loop.index }}})})
 same => n,GotoIf($["${STAT(e,${RECNAMEPATH{{ loop.index }}})}" = "1"]?name{{ loop.index }})
 same => n,SayDigits({{ ext.extension }})
 same => n,Goto(pressnum{{ loop.index }})
 same => n(name{{ loop.index }}),Background(/var/spool/asterisk/voicemail/default/{{ ext.extension }}/greet)
 same => n(pressnum{{ loop.index }}),Background(vm-press)
 same => n,SayDigits({{ loop.index }})
{% endfor %}
 same => n,WaitExten({{ ivr_settings.timeout_seconds }})

{% for ext in directory_list %}
exten => {{ loop.index }},1,Goto(internal,{{ ext.extension }},1)
{% endfor %}
exten => i,1,NoOp(IVR directory list: invalid entry)
 same => n,Playback(pbx-invalid)
 same => n,Goto(s,1)

exten => t,1,NoOp(IVR directory list: timeout)
 same => n,Goto(ivr-directory,s,1)

; ------------------------------------------------------------------
; Inbound — one context per trunk, routed by DID
; ------------------------------------------------------------------
{% for trunk in trunks if trunk.enabled %}
[from-trunk-{{ trunk.name }}]
{% for route in inbound_routes if route.trunk_id == trunk.id %}
exten => {{ route.did_number }},1,NoOp(Inbound {{ route.did_number }} via {{ trunk.name }})
{% if route.time_condition and route.time_condition.start and route.time_condition.end and route.time_condition.days %}
 same => n,GotoIfTime({{ route.time_condition.start }}-{{ route.time_condition.end }},{{ route.time_condition.days }},*,*?day,night)
 same => n(night),NoOp(Outside business hours)
{{ dial_action(route.time_condition.night_destination_type or route.destination_type, route.time_condition.night_destination_value or route.destination_value) }}
 same => n,Hangup()
 same => n(day),NoOp(Business hours)
{% endif %}
{{ dial_action(route.destination_type, route.destination_value) }}
 same => n,Hangup()

{% endfor %}
exten => _X.,1,NoOp(Unmatched DID ${EXTEN} on trunk {{ trunk.name }})
 same => n,Hangup()

{% endfor %}
