# Asterisk AMI connection
AMI_HOST=192.168.0.107
AMI_PORT=5038
AMI_USERNAME=manager
AMI_SECRET=your_ami_secret_here

# Asterisk server IP (used in Polycom provisioning)
ASTERISK_IP=192.168.0.107

# File paths (host paths, mounted into container)
PJSIP_CONF=/etc/asterisk/pjsip.conf
EXTENSIONS_CONF=/etc/asterisk/extensions.conf
FEATURES_CONF=/etc/asterisk/features.conf
POLYCOM_CFG_DIR=/var/www/html/polycom

# Database
DATABASE_URL=sqlite+aiosqlite:////data/asterisk_web.db

# Optional: path to Asterisk's native CDR SQLite database
# ASTERISK_CDR_DB=/var/log/asterisk/master.db

# Backup directory
BACKUP_DIR=/data/backups

# App settings
HTTP_PORT=8080
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_random_secret
