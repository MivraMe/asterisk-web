# Copy to .env and fill in real values. Never commit the real .env.

# ------------------------------------------------------------------
# Database (Postgres) — source of truth for extensions/trunks/routes,
# also holds the cdr table that Asterisk's cdr_pgsql module writes into.
# ------------------------------------------------------------------
DB_USER=asterisk
DB_PASSWORD=change_me_db_password
DB_NAME=asterisk

# ------------------------------------------------------------------
# Asterisk Manager Interface (AMI) — shared secret between the asterisk
# and webapp containers.
# ------------------------------------------------------------------
AMI_USER=webapp
AMI_SECRET=change_me_ami_secret

# ------------------------------------------------------------------
# webapp session signing — used for the signed session cookie. Generate
# with e.g. `openssl rand -hex 32`.
# ------------------------------------------------------------------
SECRET_KEY=change_me_to_a_long_random_value

# ------------------------------------------------------------------
# Bootstrap admin account — created once on first startup if the users
# table is empty (see webapp/app/bootstrap.py). Change the password after
# first login. Leave ADMIN_PASSWORD blank to have a random one generated
# and logged once at startup instead.
# ------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# ------------------------------------------------------------------
# Email-to-voicemail relay (Resend — same provider already used for
# HomeTix). Asterisk's app_voicemail shells out to sendmail (msmtp) using
# these settings; see asterisk/etc-asterisk-templates/msmtprc.template.
# ------------------------------------------------------------------
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=587
RESEND_SMTP_USER=resend
RESEND_SMTP_PASSWORD=change_me_resend_api_key
VOICEMAIL_FROM_EMAIL=voicemail@example.com

# ------------------------------------------------------------------
# Trunk credentials — NOT read from here. Trunks (VoIP.ms, Twilio) are
# created and edited through the management UI (Trunks page) and stored
# in Postgres, then rendered into pjsip.conf. Listed here only as a
# reminder of what you'll need on hand when setting them up:
#   VoIP.ms:  SIP server (e.g. montreal.voip.ms), sub-account username, password
#   Twilio:   Elastic SIP Trunking termination URI, SIP username, password
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------
LOG_LEVEL=INFO
