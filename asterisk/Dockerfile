# syntax=docker/dockerfile:1
#
# Builds Asterisk from source (latest point release of the current LTS
# branch) on top of debian:12-slim. Multi-stage: the builder stage compiles
# Asterisk + bundled pjproject; the runtime stage only carries the installed
# binaries/libs plus the shared-library dependencies needed to run them.
#
# ASTERISK_SERIES pins the LTS branch (22 was the current LTS as of the time
# this Dockerfile was written — check https://docs.asterisk.org/About-the-Project/Asterisk-Versions/
# before bumping). Using the "-current" tarball symlink means every rebuild
# picks up the latest point release within that LTS series automatically.
ARG ASTERISK_SERIES=22

FROM debian:12-slim AS builder
ARG ASTERISK_SERIES
ARG JOBS=""

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        pkg-config \
        subversion \
        libxml2-dev \
        libncurses5-dev \
        libedit-dev \
        libsqlite3-dev \
        libssl-dev \
        libjansson-dev \
        libpq-dev \
        libsrtp2-dev \
        libspeex-dev \
        libspeexdsp-dev \
        libcurl4-openssl-dev \
        libical-dev \
        unixodbc-dev \
        uuid-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src

RUN curl -fsSL -o asterisk.tar.gz \
        "https://downloads.asterisk.org/pub/telephony/asterisk/asterisk-${ASTERISK_SERIES}-current.tar.gz" \
    && mkdir asterisk && tar -xzf asterisk.tar.gz -C asterisk --strip-components=1 \
    && rm asterisk.tar.gz

WORKDIR /usr/src/asterisk

# Bundled pjproject gives us chan_pjsip/res_pjsip*; jansson is bundled too so
# we don't fight Debian's older packaged version.
RUN ./configure --with-pjproject-bundled --with-jansson-bundled --with-crypto --with-ssl=ssl --with-srtp

# Modules required by the spec: chan_pjsip + res_pjsip* (default-enabled),
# app_voicemail (default-enabled), cdr_pgsql (default-disabled, needs
# libpq-dev which we installed above so configure detects it), res_ari*
# (default-enabled), res_musiconhold/app_dial/app_queue (default-enabled).
# We only need to explicitly flip cdr_pgsql (and its realtime cousin) on,
# plus pull in a minimal English sound/MOH package so voicemail prompts and
# hold music work out of the box.
RUN make menuselect.makeopts \
    && menuselect/menuselect --enable cdr_pgsql \
                              --enable res_config_pgsql \
                              --enable CORE-SOUNDS-EN-ULAW \
                              --enable MOH-OPSOUND-ULAW \
                              menuselect.makeopts \
    && make -j"$(nproc)" \
    && make install \
    && make config \
    && ldconfig

# ---------------------------------------------------------------------------
FROM debian:12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gettext-base \
        libxml2 \
        libncurses6 \
        libedit2 \
        libsqlite3-0 \
        libssl3 \
        libjansson4 \
        libpq5 \
        libsrtp2-1 \
        libspeex1 \
        libspeexdsp1 \
        libcurl4 \
        libical3 \
        libodbc2 \
        msmtp \
        msmtp-mta \
        uuid-runtime \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --home /var/lib/asterisk --shell /usr/sbin/nologin asterisk

COPY --from=builder /usr/sbin/asterisk /usr/sbin/asterisk
COPY --from=builder /usr/lib/asterisk /usr/lib/asterisk
COPY --from=builder /var/lib/asterisk /var/lib/asterisk
COPY --from=builder /usr/include/asterisk /usr/include/asterisk

RUN mkdir -p /etc/asterisk /var/spool/asterisk /var/log/asterisk /var/run/asterisk \
    && chown -R asterisk:asterisk /var/lib/asterisk /var/spool/asterisk /var/log/asterisk /var/run/asterisk

# Baked-in default config set, copied into the (initially empty) bind-mounted
# /etc/asterisk volume on first boot by entrypoint.sh. pjsip.conf,
# extensions.conf and voicemail.conf are generated by the webapp from DB
# state, so only stub placeholders ship here.
COPY etc-asterisk/ /etc/asterisk-defaults/
COPY etc-asterisk-templates/ /etc/asterisk-templates/
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 5060/udp 5061/tcp 10000-20000/udp 8088/tcp 5038/tcp

ENTRYPOINT ["/entrypoint.sh"]
CMD ["asterisk", "-f", "-U", "asterisk", "-G", "asterisk", "-vvv"]
