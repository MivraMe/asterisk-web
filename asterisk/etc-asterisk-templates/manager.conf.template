; Rendered from this template on every container start (see entrypoint.sh)
; so that AMI_USER/AMI_SECRET changes in .env take effect on restart without
; needing to rebuild the image.
;
; bindaddr must be reachable from the webapp container. Since this asterisk
; container runs with network_mode: host while webapp stays on the Docker
; bridge network, AMI has to listen on all interfaces (not just 127.0.0.1) —
; access is restricted instead via the permit/deny ACL below, scoped to
; loopback and the default Docker bridge ranges. Tighten the permit list if
; your Docker subnet differs (docker network inspect <bridge>).
[general]
enabled = yes
port = 5038
bindaddr = 0.0.0.0
displayconnects = yes

[${AMI_USER}]
secret = ${AMI_SECRET}
deny = 0.0.0.0/0.0.0.0
permit = 127.0.0.1/255.255.255.255
permit = 172.16.0.0/255.240.0.0
read = system,call,log,verbose,command,agent,user,config,dtmf,reporting,cdr,dialplan,originate
write = system,call,command,agent,user,config,originate,reporting
